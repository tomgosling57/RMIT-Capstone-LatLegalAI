# ============================================
# LatMatrix Legal AI — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
#   cp env.example .env
#
# Variables marked (optional|required) with defaults shown where applicable.

# =============================================================================
# LiteLLM — LLM Provider Configuration (used by Chainlit service)
# =============================================================================
# Chainlit uses LiteLLM (the ``litellm`` package) via
# ``langchain_community.chat_models.ChatLiteLLM`` for all LLM interactions.
# This gives you access to 100+ models across all major providers through a
# single unified interface.
#
# Choose ONE provider below, set the corresponding ``LLM_PROVIDER`` value,
# and populate the required environment variables for that provider.
# ---------------------------------------------------------------------------

# Provider selection — determines which env vars are required.
# Supported: openai | anthropic | openrouter | gemini | groq | together_ai |
#            ollama | azure | mistral | cohere | perplexity | deepseek
# Default: openrouter
# LLM_PROVIDER=openrouter

# Model name in LiteLLM format (see table below for examples).
# Default: deepseek/deepseek-chat (via OpenRouter)
# LLM_MODEL=deepseek/deepseek-chat

# Generic fallback API key — if set, it is automatically mapped to the
# provider-specific environment variable (e.g. OPENAI_API_KEY) at runtime.
# You can also set the provider-specific key directly instead.
# LLM_API_KEY="<your-api-key>"

# Optional base URL override for OpenAI-compatible providers.
# LLM_BASE_URL=https://openrouter.ai/api/v1

# --- Provider-specific configuration table ---
# Uncomment and fill in the variables for your chosen provider.
#
# ┌──────────────┬──────────────────────────────────────┬─────────────────────────────────┐
# │ Provider     │ LLM_PROVIDER value                   │ Required Env Vars               │
# ├──────────────┼──────────────────────────────────────┼─────────────────────────────────┤
# │ OpenAI       │ openai                               │ OPENAI_API_KEY                  │
# │              │                                      │ (or LLM_API_KEY)                │
# │              │ Models: gpt-4o, gpt-4o-mini           │                                 │
# ├──────────────┼──────────────────────────────────────┼─────────────────────────────────┤
# │ Anthropic    │ anthropic                            │ ANTHROPIC_API_KEY               │
# │              │                                      │ (or LLM_API_KEY)                │
# │              │ Models: claude-sonnet-4-20250514,     │                                 │
# │              │         claude-3-5-haiku-latest       │                                 │
# ├──────────────┼──────────────────────────────────────┼─────────────────────────────────┤
# │ OpenRouter   │ openrouter                           │ OPENROUTER_API_KEY              │
# │              │                                      │ (or LLM_API_KEY)                │
# │              │ Models: openrouter/deepseek/          │                                 │
# │              │         deepseek-chat,                │                                 │
# │              │         openrouter/openai/gpt-4o      │                                 │
# ├──────────────┼──────────────────────────────────────┼─────────────────────────────────┤
# │ Google Gemini│ gemini                               │ GEMINI_API_KEY                  │
# │              │                                      │ (or LLM_API_KEY)                │
# │              │ Models: gemini/gemini-2.0-flash-exp   │                                 │
# ├──────────────┼──────────────────────────────────────┼─────────────────────────────────┤
# │ Groq         │ groq                                 │ GROQ_API_KEY                    │
# │              │                                      │ (or LLM_API_KEY)                │
# │              │ Models: groq/llama3-70b-8192,         │                                 │
# │              │         groq/mixtral-8x7b-32768       │                                 │
# ├──────────────┼──────────────────────────────────────┼─────────────────────────────────┤
# │ Together AI  │ together_ai                          │ TOGETHERAI_API_KEY              │
# │              │                                      │ (or LLM_API_KEY)                │
# │              │ Models: together_ai/mistralai/        │                                 │
# │              │         Mixtral-8x7B-Instruct-v0.1   │                                 │
# ├──────────────┼──────────────────────────────────────┼─────────────────────────────────┤
# │ Ollama       │ ollama                               │ (none — runs locally)           │
# │ (local)      │                                      │                                 │
# │              │ Models: ollama/llama3, ollama/mistral │                                 │
# ├──────────────┼──────────────────────────────────────┼─────────────────────────────────┤
# │ Azure OpenAI │ azure                                │ AZURE_API_KEY,                  │
# │              │                                      │ AZURE_API_BASE,                 │
# │              │                                      │ AZURE_API_VERSION               │
# │              │ Models: azure/gpt-4, azure/gpt-35     │                                 │
# ├──────────────┼──────────────────────────────────────┼─────────────────────────────────┤
# │ Mistral      │ mistral                              │ MISTRAL_API_KEY                 │
# │              │                                      │ (or LLM_API_KEY)                │
# │              │ Models: mistral/mistral-large-latest  │                                 │
# ├──────────────┼──────────────────────────────────────┼─────────────────────────────────┤
# │ Cohere       │ cohere                               │ COHERE_API_KEY                  │
# │              │                                      │ (or LLM_API_KEY)                │
# │              │ Models: cohere/command-r-plus         │                                 │
# ├──────────────┼──────────────────────────────────────┼─────────────────────────────────┤
# │ Perplexity   │ perplexity                           │ PERPLEXITYAI_API_KEY            │
# │              │                                      │ (or LLM_API_KEY)                │
# │              │ Models: perplexity/llama-3.1-sonar-   │                                 │
# │              │         huge-128k-online              │                                 │
# ├──────────────┼──────────────────────────────────────┼─────────────────────────────────┤
# │ DeepSeek     │ deepseek                             │ DEEPSEEK_API_KEY                │
# │              │                                      │ (or LLM_API_KEY)                │
# │              │ Models: deepseek/deepseek-chat        │                                 │
# └──────────────┴──────────────────────────────────────┴─────────────────────────────────┘

LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# =============================================================================
# Chainlit Service
# =============================================================================
# Authentication secret — generated via `chainlit create-secret`.
# Required for Chainlit auth to function correctly.
CHAINLIT_AUTH_SECRET="replace-with-a-generated-secret-using-chainlit"

# OAuth Configuration
GOOGLE_CLIENT_ID=dummy-google-client-id.apps.googleusercontent.com
FACEBOOK_APP_ID=dummy-facebook-app-id

# Chainlit OAuth Configuration
# Google OAuth (for Chainlit login)
OAUTH_GOOGLE_CLIENT_ID=dummy-google-client-id.apps.googleusercontent.com
OAUTH_GOOGLE_CLIENT_SECRET=dummy-google-client-secret

# In production mode, password auth is disabled; use OAuth instead.
CHAINLIT_ENV=development

# Admin credentials (dev mode only, used when CHAINLIT_ENV=development)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Maximum upload size per file in megabytes (default: 5)
MAX_UPLOAD_SIZE_MB=5

# Backend API URL (Chainlit -> FastAPI).  In Docker, this is http://api:8000.
API_BASE_URL=http://localhost:8000

# =============================================================================
# Website (Flask) — Auth & Security
# =============================================================================
# Flask secret key for session encryption.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret-key

# Flask environment (default: production)
FLASK_ENV=development

# Backend API URL (for frontend to communicate with backend)
API_URL=http://localhost:8000

# External URL for Chainlit chat (used by Flask for post-login redirects)
# CHAT_EXTERNAL_URL=http://localhost/chat

# =============================================================================
# Chat (Streamlit) — Auth
# =============================================================================
# Backend API URL (Streamlit -> FastAPI).  In Docker, this is http://api:8000.
# API_BASE_URL=http://localhost:8000
